        
import java.io.File;
import java.io.PrintWriter;
import java.io.FileNotFoundException;
import java.util.Locale;
import java.util.Scanner;
import javax.swing.JOptionPane;

public class Prog1 {
    public static void main(String[] args) {
        StringBuilder results = new StringBuilder();

        try {
            Scanner inputFile =
                new Scanner(new File("EmpData.txt"));

            PrintWriter outputFile =
                new PrintWriter("EmpDataOutput.dat");

            inputFile.useLocale(Locale.US);

            while (inputFile.hasNext()) {
                String lastName = inputFile.next();
                String firstName = inputFile.next();
                double currentSalary = inputFile.nextDouble();
                double payIncrease = inputFile.nextDouble();

                double newSalary = currentSalary
                    + (currentSalary * payIncrease / 100.0);

                String employeeName =
                    lastName + ", " + firstName;

                String percentText;

                if (payIncrease == Math.floor(payIncrease)) {
                    percentText = String.format(
                        Locale.US, "%.0f", payIncrease);
                } else {
                    percentText = String.format(
                        Locale.US, "%.1f", payIncrease);
                }

                String outputLine = String.format(
                    Locale.US,
                    "Employee name: %s%n" +
                    "Current salary: $%.2f%n" +
                    "%% pay rise: %s%%%n" +
                    "==== New salary amount: $%.2f%n%n",
                    employeeName,
                    currentSalary,
                    percentText,
                    newSalary
                );

                results.append(outputLine);
                outputFile.print(outputLine);
            }

            inputFile.close();
            outputFile.close();

            JOptionPane.showMessageDialog(
                null,
                results.toString(),
                "Employee Salary Increase",
                JOptionPane.INFORMATION_MESSAGE
            );

        } catch (FileNotFoundException e) {
            JOptionPane.showMessageDialog(
                null,
                "Error: EmpData.txt was not found.",
                "File Error",
                JOptionPane.ERROR_MESSAGE
            );
        }
    }
}
